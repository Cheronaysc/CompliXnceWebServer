@page "/employeedashboard"
@using AutoGovernance9Web.Backend.Dtos
@using AutoGovernance9Web.Backend.Services.AssesmentServices
@using AutoGovernance9Web.Backend.Services.UserServices
@inject AssessmentService assessmentService
@inject NavigationManager Navigation
@rendermode InteractiveServer
@inject NavigationManager navigationManager

<nav class="navbar navbar-expand-lg border-bottom border-secondary border-opacity-25 py-3" style="background-color: #1a161d;">
    <div class="container-fluid px-4">
        <a class="navbar-brand text-white fw-bold d-flex align-items-center gap-2" href="/employeedashboard">
            <i class="bi bi-shield-check" style="color: #a855f7;"></i>
            <span>AutoGovernance<span style="color: #a855f7;">9</span></span>
            <span class="badge bg-dark border border-secondary text-secondary ms-2 small" style="font-size: 0.7rem;">EMPLOYEE</span>
        </a>

        <div class="d-flex align-items-center gap-3">
            <div class="dropdown">
                <button class="btn btn-dark border-secondary text-white dropdown-toggle d-flex align-items-center gap-2" type="button" style="background-color: #121013 !important;">
                    <i class="bi bi-person-circle" style="color: #a855f7;"></i>
                    <span>Employee User</span>
                </button>
            </div>
        </div>
    </div>
</nav>

<div class="page-container py-4" style="background-color: #121013; min-height: calc(100vh - 65px);">
    <div class="container-fluid px-4">

        <!-- Top Header -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="text-white fw-bold mb-1">My Dashboard</h3>
                <p class="text-secondary small mb-0">Track your pending assessments and maturity metrics</p>
            </div>
        </div>

        <!-- Top Overview Row -->
        <div class="row g-4 mb-4">
            <div class="col-lg-4">
                <div class="card h-100 p-4 border-secondary shadow-sm d-flex flex-column justify-content-between" style="background-color: #1a161d !important;">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-secondary small fw-semibold text-uppercase" style="letter-spacing: 0.5px;">Overall Maturity Level</span>
                            <h4 class="large fw-semibold text-uppercase mb-0" style="color: #a855f7; letter-spacing: 0.5px;">Level 4</h4>
                        </div>
                        <p class="text-secondary small fw-normal mb-0">Complete assessments to help calculate your business's maturity!</p>
                    </div>
                </div>
            </div>

            <div class="col-lg-8">
                <div class="card h-100 p-4 border-secondary shadow-sm" style="background-color: #1a161d !important;">
                    <div class="row g-3 h-100 align-items-center">
                        <div class="col-md-6">
                            <div class="p-3 rounded border border-secondary border-opacity-50 h-100 style-hover" style="background-color: #121013; cursor: pointer;" @onclick="NavigateToAssigned">
                                <div class="d-flex align-items-center gap-3">
                                    <i class="bi bi-pencil-square fs-4" style="color: #a855f7;"></i>
                                    <div>
                                        <h6 class="text-white fw-semibold mb-0">Take Assessment</h6>
                                        <span class="text-secondary small">Complete assigned evaluations</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 rounded border border-secondary border-opacity-50 h-100 style-hover" style="background-color: #121013; cursor: pointer;" @onclick="NavigateToHistory">
                                <div class="d-flex align-items-center gap-3">
                                    <i class="bi bi-clock-history fs-4" style="color: #06b6d4;"></i>
                                    <div>
                                        <h6 class="text-white fw-semibold mb-0">View History</h6>
                                        <span class="text-secondary small">Review past submitted responses</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Proposed Assessments Section (Nested container removed) -->
        <div class="card border-secondary shadow-sm p-4 mb-4" style="background-color: #1a161d !important;">
            <div class="d-flex align-items-center gap-2 mb-3">
                <i class="bi bi-clipboard-check fs-5" style="color: #a855f7;"></i>
                <h5 class="text-white fw-bold mb-0">Proposed Assessments</h5>
            </div>

            @if (isLoading)
            {
                <div class="d-flex justify-content-center py-4">
                    <div class="spinner-border text-purple-glow" style="color: #a855f7;" role="status"></div>
                </div>
            }
            else if (proposedAssessments == null || !proposedAssessments.Any())
            {
                <div class="p-4 rounded border border-secondary border-opacity-25 text-center py-4" style="background-color: #121013;">
                    <i class="bi bi-check-circle-fill text-success fs-3 mb-2 d-block"></i>
                    <h6 class="text-white mb-1">You're All Caught Up!</h6>
                    <p class="text-secondary small mb-0">There are no pending proposed assessments for you right now.</p>
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var template in proposedAssessments)
                    {
                        <div class="assessment-card p-3 rounded border border-secondary border-opacity-50 d-flex justify-content-between align-items-center flex-wrap gap-3" style="background-color: #121013;">
                            <div class="d-flex align-items-start gap-3">
                                <div class="p-3 rounded-circle d-flex align-items-center justify-content-center" style="background: rgba(168, 85, 247, 0.1); color: #a855f7;">
                                    <i class="bi bi-file-earmark-text fs-4"></i>
                                </div>
                                <div>
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        <h6 class="text-white fw-bold mb-0">@template.TemplateTitle</h6>
                                    </div>
                                    <p class="text-secondary small mb-2">@template.Description</p>
                                    <span class="text-secondary small" style="font-size: 0.75rem;">
                                    </span>
                                </div>
                            </div>

                            <button class="btn btn-purple px-4 py-2 fw-semibold d-flex align-items-center gap-2" @onclick="() => StartAssessment(template.TemplateId)">
                                <span>Take Assessment</span>
                                <i class="bi bi-arrow-right"></i>
                            </button>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Main Dashboard domain rings, update to single row -->
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-5 g-3">
            <div class="col">
                <div class="card h-100 p-3 border-secondary shadow-sm text-center d-flex flex-column align-items-center justify-content-between" style="background-color: #1a161d !important;">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <i class="bi bi-bank fs-5" style="color: #a855f7;"></i>
                        <h6 class="text-white fw-semibold mb-0 small">Domain 1</h6>
                    </div>
                    <div class="progress-ring domain-ring-1 my-3">
                        <div class="ring-inner">
                            <span class="fw-bold text-white fs-4 lh-1">4.0</span>
                            <span class="text-secondary d-block mt-1" style="font-size: 0.65rem;">/ 5.0</span>
                        </div>
                    </div>
                    <p class="text-secondary small mb-0" style="font-size: 0.75rem;">Governance Frameworks</p>
                </div>
            </div>

            <div class="col">
                <div class="card h-100 p-3 border-secondary shadow-sm text-center d-flex flex-column align-items-center justify-content-between" style="background-color: #1a161d !important;">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <i class="bi bi-diagram-3 fs-5" style="color: #06b6d4;"></i>
                        <h6 class="text-white fw-semibold mb-0 small">Domain 2</h6>
                    </div>
                    <div class="progress-ring domain-ring-2 my-3">
                        <div class="ring-inner">
                            <span class="fw-bold text-white fs-4 lh-1">3.5</span>
                            <span class="text-secondary d-block mt-1" style="font-size: 0.65rem;">/ 5.0</span>
                        </div>
                    </div>
                    <p class="text-secondary small mb-0" style="font-size: 0.75rem;">Strategic Alignment</p>
                </div>
            </div>

            <div class="col">
                <div class="card h-100 p-3 border-secondary shadow-sm text-center d-flex flex-column align-items-center justify-content-between" style="background-color: #1a161d !important;">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <i class="bi bi-tools fs-5" style="color: #10b981;"></i>
                        <h6 class="text-white fw-semibold mb-0 small">Domain 3</h6>
                    </div>
                    <div class="progress-ring domain-ring-3 my-3">
                        <div class="ring-inner">
                            <span class="fw-bold text-white fs-4 lh-1">4.5</span>
                            <span class="text-secondary d-block mt-1" style="font-size: 0.65rem;">/ 5.0</span>
                        </div>
                    </div>
                    <p class="text-secondary small mb-0" style="font-size: 0.75rem;">Resource Optimization</p>
                </div>
            </div>

            <div class="col">
                <div class="card h-100 p-3 border-secondary shadow-sm text-center d-flex flex-column align-items-center justify-content-between" style="background-color: #1a161d !important;">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <i class="bi bi-headset fs-5" style="color: #f59e0b;"></i>
                        <h6 class="text-white fw-semibold mb-0 small">Domain 4</h6>
                    </div>
                    <div class="progress-ring domain-ring-4 my-3">
                        <div class="ring-inner">
                            <span class="fw-bold text-white fs-4 lh-1">3.0</span>
                            <span class="text-secondary d-block mt-1" style="font-size: 0.65rem;">/ 5.0</span>
                        </div>
                    </div>
                    <p class="text-secondary small mb-0" style="font-size: 0.75rem;">Risk Management</p>
                </div>
            </div>

            <div class="col">
                <div class="card h-100 p-3 border-secondary shadow-sm text-center d-flex flex-column align-items-center justify-content-between" style="background-color: #1a161d !important;">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <i class="bi bi-check2-circle fs-5" style="color: #f43f5e;"></i>
                        <h6 class="text-white fw-semibold mb-0 small">Domain 5</h6>
                    </div>
                    <div class="progress-ring domain-ring-5 my-3">
                        <div class="ring-inner">
                            <span class="fw-bold text-white fs-4 lh-1">3.9</span>
                            <span class="text-secondary d-block mt-1" style="font-size: 0.65rem;">/ 5.0</span>
                        </div>
                    </div>
                    <p class="text-secondary small mb-0" style="font-size: 0.75rem;">Performance Measurement</p>
                </div>
            </div>
        </div>

    </div>
</div>
       

       
<style>
    /* CSS Ring Layout */
    .progress-ring {
        width: 120px;
        height: 120px;
        border-radius: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .ring-inner {
        width: 90px;
        height: 90px;
        border-radius: 100%;
        background-color: #1a161d;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    /* Ring thickness & colors via conic gradients */
    .domain-ring-1 {
        background: conic-gradient(#a855f7 80%, #2d2633 0);
    }

    .domain-ring-2 {
        background: conic-gradient(#06b6d4 70%, #2d2633 0);
    }

    .domain-ring-3 {
        background: conic-gradient(#10b981 90%, #2d2633 0);
    }

    .domain-ring-4 {
        background: conic-gradient(#f59e0b 60%, #2d2633 0);
    }

    .domain-ring-5 {
        background: conic-gradient(#f43f5e 78%, #2d2633 0);
    }


</style>

@code {
    [Inject] UserSession userSession { get; set; }


    private List<AssessmentTemplateDto> proposedAssessments = new();
    private bool isLoading = true;

     protected override async Task OnInitializedAsync()
    {
        try
        {
            var currentUserId = userSession?.UserId ?? 0;
            proposedAssessments = await assessmentService.GetProposedAssessmentsForUserAsync(currentUserId);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void StartAssessment(int templateId)
    {
        Navigation.NavigateTo($"/takeassessment?templateId={templateId}");
    }

    private void NavigateToAssigned()
    {
        navigationManager.NavigateTo("/viewassessment");
    }

    private void NavigateToHistory()
    {
        navigationManager.NavigateTo("/assessmenthistory");
    }

    private void StartAssessment()
    {
        navigationManager.NavigateTo("/takeassessment");
    }

}