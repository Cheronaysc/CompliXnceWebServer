@page "/login"
@using AutoGovernance9Web.Backend.Models
@using AutoGovernance9Web.Backend.Services.UserServices
@using AutoGovernance9Web.Backend.Services.UserServices
@inject AuthenticationService authenticationService
@inject NavigationManager NavManager
@rendermode InteractiveServer

<div class="page-container py-5 d-flex align-items-center" style="background-color: #121013; min-height: 100vh;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-5">

                <h4 class="text-purple-glow fw-bold text-center mb-2">Governance Faster. <span style="color: #a855f7;">Maturity Smarter.</span></h4>
                <h2 class="text-center mb-4 text-white fw-bold">Welcome Back</h2>

                <div class="card p-4 bg-dark text-white border-secondary shadow-lg" style="background-color: #1a161d !important;">
                    <div class="card-body p-3">

                        @if (!string.IsNullOrEmpty(formError))
                        {
                            <div class="alert alert-danger small">@formError</div>
                        }
                        @if (!string.IsNullOrEmpty(formSuccess))
                        {
                            <div class="alert alert-success small">@formSuccess</div>
                        }

                        <form>
                            <div class="mb-3">
                                <label class="form-label small text-secondary fw-semibold">Email Address</label>
                                <input type="email" class="form-control bg-dark border-secondary text-white py-2"
                                       placeholder="name@company.com" style="background-color: #121013 !important;"
                                       @bind="loginRequest.Email" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label small text-secondary fw-semibold">Password</label>
                                <input type="password" class="form-control bg-dark border-secondary text-white py-2"
                                       placeholder="••••••••" style="background-color: #121013 !important;"
                                       @bind="loginRequest.Password" />
                            </div>

                            <button type="button" class="btn text-white fw-semibold w-100 py-2 mt-2"
                                    style="background-color: #a855f7;"
                                    @onclick="HandleLoginRequest" disabled="@isSubmitting">
                                @if (isSubmitting)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                Sign In<i class="bi bi-arrow-right ms-1"></i>
                            </button>
                        </form>

                        <p class="text-secondary small text-center mt-4 mb-0">
                            Don't have an account?
                            <a href="/signup" class="text-decoration-none fw-semibold" style="color: #a855f7;">Sign up</a>
                        </p>
                    </div>
                </div>
                </div>
                </div>
    </div>
</div>

@code {
    [Inject] UserSession userSession { get; set; }
    private LoginRequest loginRequest = new();
    private string formError = string.Empty;
    private string formSuccess = string.Empty;
    private bool isSubmitting = false;

    private async Task HandleLoginRequest()
    {
        formError = string.Empty;
        formSuccess = string.Empty;
        isSubmitting = true;

        try
        {
            var result = await authenticationService.LoginAsync(loginRequest);
                // Debugging: log result and current user session type to the server console
                Console.WriteLine($"[Login] result={(result == null ? "success" : "failure: " + result)}, userSession.UserType='{userSession?.UserType ?? "null"}'");
            if (result == null)
            {
                formSuccess = "Login successful. Redirecting...";
                if (string.Equals(userSession.UserType, "Admin", StringComparison.OrdinalIgnoreCase))
                {
                    NavManager.NavigateTo("/admindashboard");
                }
                else
                {
                    // Force a full page load for employee dashboard to rule out client-side routing issues
                    NavManager.NavigateTo("/employeedashboard", forceLoad: true);
                }

            }
            else
            {
                formError = result;
            }
        }
        catch (Exception ex)
        {
            formError = "Login failed. Please try again.";
            Console.WriteLine(ex.Message);
        }
        finally
        {
            isSubmitting = false;
        }
    }
}