@page "/admindashboard"
@using AutoGovernance9Web.Backend.Services.UserServices
@using AutoGovernance9Web.Backend.Services.AssesmentServices
@using AutoGovernance9Web.Backend.Dtos
@inject NavigationManager navigationManager
@inject AdminService adminService
@inject AssessmentService assessmentService
@inject UserSession userSession
@rendermode InteractiveServer

<!-- Top Admin Navigation Bar -->
<nav class="navbar navbar-expand-lg border-bottom border-secondary border-opacity-25 py-3" style="background-color: #1a161d;">
    <div class="container-fluid px-4">
        <a class="navbar-brand text-white fw-bold d-flex align-items-center gap-2" href="/admin/dashboard">
            <i class="bi bi-shield-check text-purple-glow" style="color: #a855f7;"></i>
            <span>AutoGovernance<span style="color: #a855f7;">9</span></span>
            <span class="badge bg-dark border border-secondary text-secondary ms-2 small" style="font-size: 0.7rem;">ADMIN</span>
        </a>

        <div class="d-flex align-items-center gap-3">
            <a href="createassessment" class="btn btn-sm text-white fw-semibold px-3" style="background-color: #a855f7;">
                <i class="bi bi-plus-lg me-1 "></i> New Assessment
            </a>
            <div class="dropdown">
                <button class="btn btn-dark border-secondary text-white dropdown-toggle d-flex align-items-center gap-2 " type="button" style="background-color: #121013 !important;">
                    <i class="bi bi-person-circle" style="color: #a855f7;"></i>
                    <span>Admin User</span>
                </button>
            </div>
        </div>
    </div>
</nav>

<div class="page-container py-4" style="background-color: #121013; min-height: calc(100vh - 65px);">
    <div class="container-fluid px-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="text-white fw-bold mb-1">Organizational Maturity Overview</h3>
                <p class="text-secondary small mb-0">Real-time aggregate scores across COBIT 2019 & ISO 38500 frameworks</p>
            </div>
        </div>

        <!-- Overall score -->
        <div class="row g-4 mb-4">
            <div class="col-lg-4">
                <div class="card h-100 p-4 border-secondary shadow-sm d-flex flex-column justify-content-between" style="background-color: #1a161d !important;">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-secondary small fw-semibold text-uppercase" style="letter-spacing: 0.5px;">Overall Maturity Score</span>
                            <span class="badge text-white px-2 py-1 small" style="background-color: #a855f7;">
                                Level @Math.Round(orgScoreResult.FinalMaturityScore)
                            </span>
                        </div>
                        <div class="d-flex align-items-baseline gap-2 mb-2">
                            <h1 class="display-3 fw-bold text-white mb-0">@orgScoreResult.FinalMaturityScore.ToString("0.0")</h1>
                            <span class="text-secondary fs-5">/ 5.0</span>
                        </div>
                        <p class="text-secondary small mb-0">
                            <i class="bi bi-info-circle text-purple me-1" style="color: #a855f7;"></i> Aggregated from completed assessment runs.
                        </p>
                    </div>
                    <div class="progress bg-dark mt-3 border border-secondary border-opacity-25" style="height: 8px;">
                        <div class="progress-bar" style="width: @((orgScoreResult.FinalMaturityScore / 5.0) * 100)%; background-color: #a855f7;"></div>
                    </div>
                </div>
            </div>

            <!-- Dashboard quick actions -->
            <div class="col-lg-8">
                <div class="card h-100 p-4 border-secondary shadow-sm" style="background-color: #1a161d !important;">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="text-white fw-bold mb-0">Quick Management Tools</h6>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="p-3 rounded border border-secondary border-opacity-50 h-100" style="background-color: #121013; cursor: pointer;" @onclick="NavigateToCreateAssesment">
                                <div class="d-flex align-items-center gap-3 mb-2">
                                    <i class="bi bi-journal-plus fs-4" style="color: #a855f7;"></i>
                                    <div>
                                        <h6 class="text-white fw-semibold mb-0">Create Assessment</h6>
                                        <span class="text-secondary small">Deploy new assessment to department</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 rounded border border-secondary border-opacity-50 h-100" style="background-color: #121013;">
                                <div class="d-flex align-items-center gap-3 mb-2">
                                    <i class="bi bi-people-fill fs-4" style="color: #a855f7;"></i>
                                    <div>
                                        <h6 class="text-white fw-semibold mb-0">Manage Employees</h6>
                                        <span class="text-secondary small">View active participants (@totalSubmissionsCount submissions)</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <h5 class="text-white fw-bold mb-3">Domain Performance Breakdown</h5>

        <!-- 2 Top, 3 Bottom Domain Grid layout -->
        @if (orgScoreResult.DomainScores.Any())
        {
            var domains = orgScoreResult.DomainScores.ToList();

            <div class="domain-grid-custom mb-4">
                @for (int i = 0; i < domains.Count; i++)
                {
                    var domain = domains[i];
                    double percentage = (domain.DomainAverage / 5.0) * 100;
                    int ringIndex = i + 1;

                    <div class="domain-box">
                        <h6 class="text-white fw-semibold mb-3">@domain.DomainName</h6>

                        <div class="progress-ring ring-color-var-@ringIndex my-2" style="background: conic-gradient(var(--ring-color-@ringIndex) @percentage%, #221c24 0);">
                            <div class="ring-inner ring-inner-glow-@ringIndex">
                                <span class="fw-bold text-white fs-3 lh-1">@domain.DomainAverage.ToString("0.0")</span>
                                <span class="text-secondary d-block mt-1" style="font-size: 0.7rem;">/ 5.0</span>
                            </div>
                        </div>

                        <p class="text-secondary small mt-3 mb-0" style="font-size: 0.75rem;">//preview text</p>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="row mb-4">
                <div class="col-12 text-center py-4 text-secondary card border-secondary" style="background-color: #1a161d !important;">
                    <p class="mb-0">No assessment metrics calculated yet. Click calculation actions to load metrics.</p>
                </div>
            </div>
        }

        <!-- Active Assessments Table (Real Data) -->
        <div class="card border-secondary shadow-sm p-4" style="background-color: #1a161d !important;">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="text-white fw-bold mb-0">Active Assessment Runs</h6>
            </div>
            <div class="table-responsive">
                @if (isLoadingAssessments)
                {
                    <div class="d-flex justify-content-center py-4">
                        <div class="spinner-border text-purple" style="color: #a855f7;" role="status"></div>
                    </div>
                }
                else if (activeRuns == null || !activeRuns.Any())
                {
                    <div class="text-center py-4 text-secondary">
                        <p class="mb-0">No active assessment runs found for your organization.</p>
                    </div>
                }
                else
                {
                    <table class="table table-dark table-hover mb-0 align-middle" style="--bs-table-bg: transparent;">
                        <thead class="text-secondary border-bottom border-secondary border-opacity-50 small">
                            <tr>
                                <th>Assessment Name</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="border-0">
                            @foreach (var run in activeRuns)
                            {
                                <tr>
                                    <td class="fw-semibold text-white">@run.TemplateTitle</td>
                                    <td>
                                        <span class="badge bg-success bg-opacity-25 text-success border border-success">
                                            @statusString
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <button class="btn btn-sm text-white fw-semibold px-3"
                                                style="background-color: #a855f7;"
                                                @onclick="() => TriggerScoreCalculation()">
                                            <i class="bi bi-check-circle me-1"></i> Complete Assessment Run
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>

<style>
    :root {
        --ring-color-1: #a855f7;
        --ring-color-2: #06b6d4;
        --ring-color-3: #10b981;
        --ring-color-4: #f59e0b;
        --ring-color-5: #f43f5e;
    }

    /* Custom 2-top, 3-bottom grid layout */
    .domain-grid-custom {
        display: grid;
        grid-template-columns: repeat(6, 1fr);
        gap: 1rem;
    }

        /* First row: 2 items spanning 3 columns each */
        .domain-grid-custom > .domain-box:nth-child(1),
        .domain-grid-custom > .domain-box:nth-child(2) {
            grid-column: span 3;
        }

        /* Second row: 3 items spanning 2 columns each */
        .domain-grid-custom > .domain-box:nth-child(3),
        .domain-grid-custom > .domain-box:nth-child(4),
        .domain-grid-custom > .domain-box:nth-child(5) {
            grid-column: span 2;
        }

    .domain-box {
        background-color: #1a161d !important;
        border: 1px solid var(--bs-secondary);
        border-radius: 0.375rem;
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
    }

    .progress-ring {
        width: 199px;
        height: 199px;
        border-radius: 80%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .ring-color-var-1 {
        box-shadow: 0 0 18px rgba(168, 85, 247, 0.35);
    }

    .ring-color-var-2 {
        box-shadow: 0 0 18px rgba(6, 182, 212, 0.35);
    }

    .ring-color-var-3 {
        box-shadow: 0 0 18px rgba(16, 185, 129, 0.35);
    }

    .ring-color-var-4 {
        box-shadow: 0 0 18px rgba(245, 158, 11, 0.35);
    }

    .ring-color-var-5 {
        box-shadow: 0 0 18px rgba(244, 63, 94, 0.35);
    }

    .ring-inner {
        width: 100px;
        height: 100px;
        border-radius: 100%;
        background-color: #1a161d;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .ring-inner-glow-1 {
        box-shadow: inset 0 0 12px rgba(168, 85, 247, 0.4);
    }

    .ring-inner-glow-2 {
        box-shadow: inset 0 0 12px rgba(6, 182, 212, 0.4);
    }

    .ring-inner-glow-3 {
        box-shadow: inset 0 0 12px rgba(16, 185, 129, 0.4);
    }

    .ring-inner-glow-4 {
        box-shadow: inset 0 0 12px rgba(245, 158, 11, 0.4);
    }

    .ring-inner-glow-5 {
        box-shadow: inset 0 0 12px rgba(244, 63, 94, 0.4);
    }
</style>

@code {
    private AssessmentScoreResultDto orgScoreResult = new();
    private List<AssessmentTemplateDto> activeRuns = new();
    private int totalSubmissionsCount = 0;
    private bool isLoadingAssessments = true;
    private string? errorMessage = null;
    private string statusString = "ongoing";


    protected override async Task OnInitializedAsync()
    {
        try
        {
            totalSubmissionsCount = await assessmentService.GetTotalSubmissionsCountAsync(userSession.CompanyId);
            orgScoreResult = await assessmentService.CalculateOrganizationMaturityAsync(userSession.CompanyId);

            // Fetch live assessment templates / active runs for the company context
            activeRuns = await assessmentService.GetProposedAssessmentsForUserAsync(userSession.UserId, userSession.CompanyId);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Initialization error: {ex.Message}");
        }
        finally
        {
            isLoadingAssessments = false;
        }
    }

    private async Task TriggerScoreCalculation()
    {
        try
        {
            totalSubmissionsCount = await assessmentService.GetTotalSubmissionsCountAsync(userSession.CompanyId);
            orgScoreResult = await assessmentService.CalculateOrganizationMaturityAsync(userSession.CompanyId);
            statusString = "complete";
            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            StateHasChanged();
        }
    }

    public void NavigateToCreateAssesment()
    {
        navigationManager.NavigateTo("/createassessment");
    }
}