@page "/admindashboard"
@using AutoGovernance9Web.Backend.Services.UserServices
@using AutoGovernance9Web.Backend.Services.AssesmentServices
@using AutoGovernance9Web.Backend.Dtos
@inject NavigationManager navigationManager
@inject AdminService adminService
@inject AssessmentService assessmentService
@rendermode InteractiveServer

<!-- Top Admin Navigation Bar -->
<nav class="navbar navbar-expand-lg border-bottom border-secondary border-opacity-25 py-3" style="background-color: #1a161d;">
    <div class="container-fluid px-4">
        <a class="navbar-brand text-white fw-bold d-flex align-items-center gap-2" href="/admin/dashboard">
            <i class="bi bi-shield-check text-purple-glow" style="color: #a855f7;"></i>
            <span>AutoGovernance<span style="color: #a855f7;">9</span></span>
            <span class="badge bg-dark border border-secondary text-secondary ms-2 small" style="font-size: 0.7rem;">ADMIN</span>
        </a>

        <div class="d-flex align-items-center gap-3">
            <a href="createassessment" class="btn btn-sm text-white fw-semibold px-3" style="background-color: #a855f7;">
                <i class="bi bi-plus-lg me-1 "></i> New Assessment
            </a>
            <div class="dropdown">
                <button class="btn btn-dark border-secondary text-white dropdown-toggle d-flex align-items-center gap-2 " type="button" style="background-color: #121013 !important;">
                    <i class="bi bi-person-circle" style="color: #a855f7;"></i>
                    <span>Admin User</span>
                </button>
            </div>
        </div>
    </div>
</nav>

<div class="page-container py-4" style="background-color: #121013; min-height: calc(100vh - 65px);">
    <div class="container-fluid px-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="text-white fw-bold mb-1">Organizational Maturity Overview</h3>
                <p class="text-secondary small mb-0">Real-time aggregate scores across COBIT 2019 & ISO 38500 frameworks</p>
            </div>
        </div>

        <!-- Overall score -->
        <div class="row g-4 mb-4">
            <div class="col-lg-4">
                <div class="card h-100 p-4 border-secondary shadow-sm d-flex flex-column justify-content-between" style="background-color: #1a161d !important;">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-secondary small fw-semibold text-uppercase" style="letter-spacing: 0.5px;">Overall Maturity Score</span>
                            <span class="badge text-white px-2 py-1 small" style="background-color: #a855f7;">
                                Level @Math.Round(orgScoreResult.FinalMaturityScore)
                            </span>
                        </div>
                        <div class="d-flex align-items-baseline gap-2 mb-2">
                            <h1 class="display-3 fw-bold text-white mb-0">@orgScoreResult.FinalMaturityScore.ToString("0.0")</h1>
                            <span class="text-secondary fs-5">/ 5.0</span>
                        </div>
                        <p class="text-secondary small mb-0">
                            <i class="bi bi-info-circle text-purple me-1" style="color: #a855f7;"></i> Aggregated from completed assessment runs.
                        </p>
                    </div>
                    <div class="progress bg-dark mt-3 border border-secondary border-opacity-25" style="height: 8px;">
                        <div class="progress-bar" style="width: @((orgScoreResult.FinalMaturityScore / 5.0) * 100)%; background-color: #a855f7;"></div>
                    </div>
                </div>
            </div>

            <!-- Dashboard quick actions -->
            <div class="col-lg-8">
                <div class="card h-100 p-4 border-secondary shadow-sm" style="background-color: #1a161d !important;">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="text-white fw-bold mb-0">Quick Management Tools</h6>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="p-3 rounded border border-secondary border-opacity-50 h-100" style="background-color: #121013; cursor: pointer;" @onclick="NavigateToCreateAssesment">
                                <div class="d-flex align-items-center gap-3 mb-2">
                                    <i class="bi bi-journal-plus fs-4" style="color: #a855f7;"></i>
                                    <div>
                                        <h6 class="text-white fw-semibold mb-0">Create Assessment</h6>
                                        <span class="text-secondary small">Deploy new assessment to department</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 rounded border border-secondary border-opacity-50 h-100" style="background-color: #121013;">
                                <div class="d-flex align-items-center gap-3 mb-2">
                                    <i class="bi bi-people-fill fs-4" style="color: #a855f7;"></i>
                                    <div>
                                        <h6 class="text-white fw-semibold mb-0">Manage Employees</h6>
                                        <span class="text-secondary small">View active participants (@totalSubmissionsCount submissions)</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <h5 class="text-white fw-bold mb-3">Domain Performance Breakdown</h5>

        <!-- Dynamic Domain Performance Rings -->
        @if (orgScoreResult.DomainScores.Any())
        {
            var domains = orgScoreResult.DomainScores.ToList();
            int index = 1;

            <div class="row g-4 mb-4 justify-content-center">
                <!-- Top Row: First 3 Domains -->
                <div class="col-12">
                    <div class="row row-cols-1 row-cols-md-3 g-3 justify-content-center">
                        @for (int i = 0; i < Math.Min(3, domains.Count); i++)
                        {
                            var domain = domains[i];
                            double percentage = (domain.DomainAverage / 5.0) * 100;
                            int ringIndex = i + 1;

                            <div class="col">
                                <div class="card h-100 p-3 border-secondary shadow-sm text-center d-flex flex-column align-items-center justify-content-between" style="background-color: #1a161d !important;">
                                    <div class="d-flex align-items-center gap-2 mb-2">
                                        <i class="bi bi-bank fs-5" style="color: #a855f7;"></i>
                                        <h6 class="text-white fw-semibold mb-0 small">@domain.DomainName</h6>
                                    </div>

                                    <div class="progress-ring domain-ring-@ringIndex my-3" style="background: conic-gradient(var(--ring-color-@ringIndex) @percentage%, #2d2633 0);">
                                        <div class="ring-inner">
                                            <span class="fw-bold text-white fs-4 lh-1">@domain.DomainAverage.ToString("0.0")</span>
                                            <span class="text-secondary d-block mt-1" style="font-size: 0.65rem;">/ 5.0</span>
                                        </div>
                                    </div>

                                    <p class="text-secondary small mb-0" style="font-size: 0.75rem;">Average Score</p>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Bottom Row: Remaining Domains (e.g., 2 on bottom, centered) -->
                @if (domains.Count > 3)
                {
                    <div class="col-12">
                        <div class="row row-cols-1 row-cols-md-2 g-3 justify-content-center" style="max-width: 66%; margin: 0 auto;">
                            @for (int i = 3; i < domains.Count; i++)
                            {
                                var domain = domains[i];
                                double percentage = (domain.DomainAverage / 5.0) * 100;
                                int ringIndex = i + 1;

                                <div class="col">
                                    <div class="card h-100 p-3 border-secondary shadow-sm text-center d-flex flex-column align-items-center justify-content-between" style="background-color: #1a161d !important;">
                                        <div class="d-flex align-items-center gap-2 mb-2">
                                            <i class="bi bi-bank fs-5" style="color: #a855f7;"></i>
                                            <h6 class="text-white fw-semibold mb-0 small">@domain.DomainName</h6>
                                        </div>

                                        <div class="progress-ring domain-ring-@ringIndex my-3" style="background: conic-gradient(var(--ring-color-@ringIndex) @percentage%, #2d2633 0);">
                                            <div class="ring-inner">
                                                <span class="fw-bold text-white fs-4 lh-1">@domain.DomainAverage.ToString("0.0")</span>
                                                <span class="text-secondary d-block mt-1" style="font-size: 0.65rem;">/ 5.0</span>
                                            </div>
                                        </div>

                                        <p class="text-secondary small mb-0" style="font-size: 0.75rem;">Average Score</p>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="row mb-4">
                <div class="col-12 text-center py-4 text-secondary card border-secondary" style="background-color: #1a161d !important;">
                    <p class="mb-0">No assessment metrics calculated yet. Click "Complete Assessment" to load metrics.</p>
                </div>
            </div>
        }


        </div>

        <!-- Temporary Debug Info Banner -->
        <div class="alert alert-secondary text-white mb-3" style="background-color: #1a161d; border-color: #a855f7;">
            <span><strong>Debug Status:</strong> Submissions Count = @totalSubmissionsCount | Final Score = @orgScoreResult.FinalMaturityScore | Domains Loaded = @orgScoreResult.DomainScores.Count</span>
        </div>

        <!-- Active Assessments Table -->
        <div class="card border-secondary shadow-sm p-4" style="background-color: #1a161d !important;">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="text-white fw-bold mb-0">Active Assessment Runs</h6>
            </div>
            <div class="table-responsive">
                <table class="table table-dark table-hover mb-0 align-middle" style="--bs-table-bg: transparent;">
                    <thead class="text-secondary border-bottom border-secondary border-opacity-50 small">
                        <tr>
                            <th>Assessment Name</th>
                            <th>Status</th>
                            <th>Score</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="border-0">
                        <!-- Example row wired up with your completion trigger -->
                        <tr>
                            <td class="fw-semibold text-white">....</td>
                            <td><span class="badge bg-success bg-opacity-25 text-success border border-success">In Progress</span></td>
                            <td style="width: 200px;">
                                <div class="progress bg-dark" style="height: 6px;">
                                    <div class="progress-bar" style="width: 65%; background-color: #a855f7;"></div>
                                </div>
                            </td>
                            <td class="text-end">
                                <button class="btn btn-sm text-white fw-semibold px-3"
                                        style="background-color: #a855f7;"
                                        @onclick="() => TriggerScoreCalculation()">
                                    <i class="bi bi-check-circle me-1"></i> Complete Assessment
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

<style>
    :root {
        --ring-color-1: #a855f7;
        --ring-color-2: #06b6d4;
        --ring-color-3: #10b981;
        --ring-color-4: #f59e0b;
        --ring-color-5: #f43f5e;
    }

    .progress-ring {
        width: 150px;
        height: 150px;
        border-radius: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .ring-inner {
        width: 85px;
        height: 85px;
        border-radius: 90%;
        background-color: #1a161d;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }
</style>

@code {
    private AssessmentScoreResultDto orgScoreResult = new();
    private int totalSubmissionsCount = 0;
    private string? errorMessage = null;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            totalSubmissionsCount = await assessmentService.GetTotalSubmissionsCountAsync();
            // Automatically calculate initial dashboard metrics on load
            orgScoreResult = await assessmentService.CalculateOrganizationMaturityAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Initialization error: {ex.Message}");
        }
    }

   private async Task TriggerScoreCalculation()
    {
        try
        {
            // 1. Fetch total submission volume
            totalSubmissionsCount = await assessmentService.GetTotalSubmissionsCountAsync();

            // 2. Run the SQL query to crunch domain and overall averages
            orgScoreResult = await assessmentService.CalculateOrganizationMaturityAsync();

            // 3. Force the UI to update with the new numbers and rings
            StateHasChanged();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message; // Capture the exact error
            StateHasChanged();
        }
    }

    public void NavigateToCreateAssesment()
    {
        navigationManager.NavigateTo("/createassessment");
    }
}