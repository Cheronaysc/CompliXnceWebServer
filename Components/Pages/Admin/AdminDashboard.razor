@page "/admindashboard"
@inject NavigationManager navigationManager

<!-- Top Admin Navigation Bar -->
<nav class="navbar navbar-expand-lg border-bottom border-secondary border-opacity-25 py-3" style="background-color: #1a161d;">
    <div class="container-fluid px-4">
        <a class="navbar-brand text-white fw-bold d-flex align-items-center gap-2" href="/admin/dashboard">
            <i class="bi bi-shield-check text-purple-glow" style="color: #a855f7;"></i>
            <span>AutoGovernance<span style="color: #a855f7;">9</span></span>
            <span class="badge bg-dark border border-secondary text-secondary ms-2 small" style="font-size: 0.7rem;">ADMIN</span>
        </a>

        <div class="d-flex align-items-center gap-3">
            <a href="createassessment" class="btn btn-sm text-white fw-semibold px-3" style="background-color: #a855f7;">
                <i class="bi bi-plus-lg me-1 "></i> New Assessment
            </a>
            <div class="dropdown">
                <button class="btn btn-dark border-secondary text-white dropdown-toggle d-flex align-items-center gap-2 " type="button" style="background-color: #121013 !important;">
                    <i class="bi bi-person-circle" style="color: #a855f7;"></i>
                    <span>Admin User</span>
                </button>
            </div>
        </div>
    </div>
</nav>

<div class="page-container py-4" style="background-color: #121013; min-height: calc(100vh - 65px);">
    <div class="container-fluid px-4">


        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="text-white fw-bold mb-1">Organizational Maturity Overview</h3>
                <p class="text-secondary small mb-0">Real-time aggregate scores across COBIT 2019 & ISO 38500 frameworks</p>
            </div>
            <div class="d-flex gap-2">
            </div>
        </div>

        <!-- Overall score -->
        <div class="row g-4 mb-4">
            <div class="col-lg-4">
                <div class="card h-100 p-4 border-secondary shadow-sm d-flex flex-column justify-content-between" style="background-color: #1a161d !important;">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-secondary small fw-semibold text-uppercase" style="letter-spacing: 0.5px;">Overall Maturity Score</span>
                            <span class="badge bg-purple text-white px-2 py-1 small" style="background-color: #a855f7;">Level 4</span>
                        </div>
                        <div class="d-flex align-items-baseline gap-2 mb-2">
                            <h1 class="display-3 fw-bold text-white mb-0">3.9</h1>
                            <span class="text-secondary fs-5">/ 5.0</span>
                        </div>
                        <p class="text-secondary small mb-0">
                            <i class="bi bi-arrow-up-right text-success me-1"></i>+0.4 increase from previous quarter assessment.
                        </p>
                    </div>
                    <div class="progress bg-dark mt-3 border border-secondary border-opacity-25" style="height: 8px;">
                        <div class="progress-bar" style="width: 78%; background-color: #a855f7;"></div>
                    </div>
                </div>
            </div>

            <!-- Dashboard quick actions -->
            <div class="col-lg-8">
                <div class="card h-100 p-4 border-secondary shadow-sm" style="background-color: #1a161d !important;">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="text-white fw-bold mb-0">Quick Management Tools</h6>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="p-3 rounded border border-secondary border-opacity-50 h-100" style="background-color: #121013;">
                                <div class="d-flex align-items-center gap-3 mb-2">
                                    <i class="bi bi-journal-plus fs-4" style="color: #a855f7;"></i>
                                    <div>
                                        <h6 class="text-white fw-semibold mb-0"@onclick="NavigateToCreateAssesment"> Create Assessment </h6>
                                        <span class="text-secondary small">Deploy new assesment  to department</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 rounded border border-secondary border-opacity-50 h-100" style="background-color: #121013;">
                                <div class="d-flex align-items-center gap-3 mb-2">
                                    <i class="bi bi-people-fill fs-4" style="color: #a855f7;"></i>
                                    <div>
                                        <h6 class="text-white fw-semibold mb-0">Manage Employees</h6>
                                        <span class="text-secondary small">view active patricipants</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>


        <h5 class="text-white fw-bold mb-3">Domain Performance Breakdown</h5>

        <!-- CSS Gradient Rings -->
        <div class="row g-3 mb-4">
            <!-- Domain 1 -->
            <div class="col-md-4 col-lg-2-4">
                <div class="card h-100 p-3 border-secondary shadow-sm text-center d-flex flex-column align-items-center justify-content-between" style="background-color: #1a161d !important;">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <i class="bi bi-bank fs-5" style="color: #a855f7;"></i>
                        <h6 class="text-white fw-semibold mb-0 small">Domain 1</h6>
                    </div>

                    <div class="progress-ring domain-ring-1 my-3">
                        <div class="ring-inner">
                            <span class="fw-bold text-white fs-4 lh-1">4.2</span>
                            <span class="text-secondary d-block mt-1" style="font-size: 0.65rem;">/ 5.0</span>
                        </div>
                    </div>

                    <p class="text-secondary small mb-0" style="font-size: 0.75rem;">//preview text</p>
                </div>
            </div>

            <!-- Domain 2-->
            <div class="col-md-4 col-lg-2-4">
                <div class="card h-100 p-3 border-secondary shadow-sm text-center d-flex flex-column align-items-center justify-content-between" style="background-color: #1a161d !important;">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <i class="bi bi-diagram-3 fs-5" style="color: #06b6d4;"></i>
                        <h6 class="text-white fw-semibold mb-0 small">Domain 2</h6>
                    </div>

                    <div class="progress-ring domain-ring-2 my-3">
                        <div class="ring-inner">
                            <span class="fw-bold text-white fs-4 lh-1">3.6</span>
                            <span class="text-secondary d-block mt-1" style="font-size: 0.65rem;">/ 5.0</span>
                        </div>
                    </div>

                    <p class="text-secondary small mb-0" style="font-size: 0.75rem;">//preview text</p>
                </div>
            </div>

            <!-- Domain 3 -->
            <div class="col-md-4 col-lg-2-4">
                <div class="card h-100 p-3 border-secondary shadow-sm text-center d-flex flex-column align-items-center justify-content-between" style="background-color: #1a161d !important;">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <i class="bi bi-tools fs-5" style="color: #10b981;"></i>
                        <h6 class="text-white fw-semibold mb-0 small">Domain 3</h6>
                    </div>

                    <div class="progress-ring domain-ring-3 my-3">
                        <div class="ring-inner">
                            <span class="fw-bold text-white fs-4 lh-1">4.8</span>
                            <span class="text-secondary d-block mt-1" style="font-size: 0.65rem;">/ 5.0</span>
                        </div>
                    </div>

                    <p class="text-secondary small mb-0" style="font-size: 0.75rem;">//preview text</p>
                </div>
            </div>

            <!-- Domain 4-->
            <div class="col-md-6 col-lg-2-4">
                <div class="card h-100 p-3 border-secondary shadow-sm text-center d-flex flex-column align-items-center justify-content-between" style="background-color: #1a161d !important;">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <i class="bi bi-headset fs-5" style="color: #f59e0b;"></i>
                        <h6 class="text-white fw-semibold mb-0 small">Domain 4</h6>
                    </div>

                    <div class="progress-ring domain-ring-4 my-3">
                        <div class="ring-inner">
                            <span class="fw-bold text-white fs-4 lh-1">3.1</span>
                            <span class="text-secondary d-block mt-1" style="font-size: 0.65rem;">/ 5.0</span>
                        </div>
                    </div>

                    <p class="text-secondary small mb-0" style="font-size: 0.75rem;">//preview text</p>
                </div>
            </div>

            <!-- Domain 5-->
            <div class="col-md-6 col-lg-2-4">
                <div class="card h-100 p-3 border-secondary shadow-sm text-center d-flex flex-column align-items-center justify-content-between" style="background-color: #1a161d !important;">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <i class="bi bi-check2-circle fs-5" style="color: #f43f5e;"></i>
                        <h6 class="text-white fw-semibold mb-0 small">Domain 5</h6>
                    </div>

                    <div class="progress-ring domain-ring-5 my-3">
                        <div class="ring-inner">
                            <span class="fw-bold text-white fs-4 lh-1">3.8</span>
                            <span class="text-secondary d-block mt-1" style="font-size: 0.65rem;">/ 5.0</span>
                        </div>
                    </div>

                    <p class="text-secondary small mb-0" style="font-size: 0.75rem;">//preview text</p>
                </div>
            </div>
        </div>

        <!-- Recent assesments-->
        <div class="card border-secondary shadow-sm p-4" style="background-color: #1a161d !important;">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="text-white fw-bold mb-0">Active Assessment Runs</h6>
            </div>
            <div class="table-responsive">
                <table class="table table-dark table-hover mb-0 align-middle" style="--bs-table-bg: transparent;">
                    <thead class="text-secondary border-bottom border-secondary border-opacity-50 small">
                        <tr>
                            <th>Assessment Name</th>
                            <th>Status</th>
                            <th>Score</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="border-0">
                        <tr>
                            <td class="fw-semibold text-white">Audit 2</td>

                            <td><span class="badge bg-success bg-opacity-25 text-success border border-success">In Progress</span></td>
                            <td style="width: 200px;">
                                <div class="progress bg-dark" style="height: 6px;">
                                    <div class="progress-bar" style="width: 65%; background-color: #a855f7;"></div>
                                </div>
                            </td>
                            <td class="text-end">
                            </td>
                        </tr>
                        <tr>
                            <td class="fw-semibold text-white">Audit 1</td>
                            <td><span class="badge bg-dark border border-secondary text-light">Completed</span></td>
                            <td style="width: 200px;">
                                <div class="progress bg-dark" style="height: 6px;">
                                    <div class="progress-bar" style="width: 90%; background-color: #a855f7;"></div>
                                </div>
                            </td>
                            <td class="text-end">
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>

<style>
    /*  CSS Ring Layout */
    .progress-ring {
        width: 200px;
        height: 200px;
        border-radius: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .ring-inner {
        width: 100px; 
        height: 100px;
        border-radius: 90%;
        background-color: #1a161d;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    /* Ring thickness, & colors via gradients */
    .domain-ring-1 {
        background: conic-gradient(#a855f7 84%, #2d2633 0);
    }
    /* purple */
    .domain-ring-2 {
        background: conic-gradient(#06b6d4 72%, #2d2633 0);
    }
    /* cyan */
    .domain-ring-3 {
        background: conic-gradient(#10b981 96%, #2d2633 0);
    }
    /* emrald */
    .domain-ring-4 {
        background: conic-gradient(#f59e0b 62%, #2d2633 0);
    }
    /* yellow */
    .domain-ring-5 {
        background: conic-gradient(#f43f5e 76%, #2d2633 0);
    }
    /* pink */

    {
        .col-lg-2-4 {
            flex: 0 0 auto;
            width: 40%;
        }
    }
</style>
@code{

    public void NavigateToCreateAssesment(){
        navigationManager.NavigateTo("/createassessment");
    }


}